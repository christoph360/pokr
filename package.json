{
  "name": "pokr",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @pokr/api dev\" \"pnpm --filter @pokr/web dev\"",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --if-present test",
    "test:e2e": "pnpm --filter @pokr/e2e test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
