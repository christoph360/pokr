{
  "name": "@pokr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist/web/browser && wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc -p tsconfig.json",
    "types": "wrangler types",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@pokr/shared": "workspace:*",
    "hono": "^4.13.13",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@pokr/web": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
